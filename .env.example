# ── Phase 1: LLM script generation ───────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Phase 1: Image generation ────────────────────────────
# Uses Stable Diffusion from Hugging Face (runwayml/stable-diffusion-v1-5)
# No API key needed! Runs locally with GPU/CPU
# Falls back to placeholder PNG if torch/diffusers not installed
OPENAI_API_KEY=

# ── Phase 2: Background music (optional) ─────────────────
# Leave blank → uses data/bgm_library/neutral_ambient.mp3 fallback
# Get key free at: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# ── Phase 3: Image generation ─────────────────────────────
# Get token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# ── Memory backend ────────────────────────────────────────
# chromadb (default, persistent) | mock (in-memory, for tests)
MEMORY_BACKEND=chromadb

# ── Phase 3: Wav2Lip lip sync (optional) ─────────────────
# Without these, falls back to OpenCV frame+audio mux
WAV2LIP_CHECKPOINT=Wav2Lip/checkpoints/wav2lip_gan.pth
WAV2LIP_REPO_PATH=Wav2Lip
